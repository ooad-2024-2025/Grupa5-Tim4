{
  "dashboard": {
    "title": "NaPoso Application Dashboard",
    "panels": [
      {
        "title": "Request Rate",
        "type": "timeseries",
        "targets": [{ "expr": "rate(http_requests_total[5m])" }]
      },
      {
        "title": "Response Time p95",
        "type": "timeseries",
        "targets": [{ "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))" }]
      },
      {
        "title": "Error Rate",
        "type": "timeseries",
        "targets": [{ "expr": "rate(http_requests_total{status=~'5..'}[5m]) / rate(http_requests_total[5m])" }]
      },
      {
        "title": "Active Connections",
        "type": "stat",
        "targets": [{ "expr": "http_connections_active" }]
      }
    ],
    "alerts": [
      {
        "name": "High Error Rate",
        "condition": "error_rate > 0.05",
        "severity": "critical",
        "action": "Page on-call"
      },
      {
        "name": "High Latency",
        "condition": "p95_response_time > 2000ms",
        "severity": "warning",
        "action": "Notify team"
      },
      {
        "name": "Service Down",
        "condition": "health_live == 0",
        "severity": "critical",
        "action": "Page on-call"
      }
    ]
  }
}
