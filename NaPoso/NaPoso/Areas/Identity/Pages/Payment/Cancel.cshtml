@page
@model NaPoso.Areas.Identity.Pages.Payment.CancelModel
@{
    ViewData["Title"] = "Plaćanje otkazano";
}

<div class="auth-container">
    <div class="auth-card text-center">
        <h1 class="auth-icon" style="color: var(--color-danger);"><i class="bi bi-x-circle-fill"></i></h1>
        <h1 style="color: var(--color-danger);">Plaćanje otkazano</h1>
        <p class="lead">Vaše plaćanje je otkazano. Nema naplaćenih iznosa.</p>

        <div class="d-flex gap-3 justify-content-center mt-6">
            @if (Model.OglasId.HasValue)
            {
                <a asp-controller="Oglas" asp-action="PrijavljeniRadnici" asp-route-oglasId="@Model.OglasId" class="btn btn-primary">
                    <i class="bi bi-arrow-left me-1"></i>Natrag na prijave
                </a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house me-1"></i>Početna
                </a>
            }
        </div>
    </div>
</div>
