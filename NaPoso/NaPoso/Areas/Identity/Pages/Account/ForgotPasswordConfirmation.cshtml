@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Email poslan";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-icon"><i class="bi bi-envelope-check"></i></h1>
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Provjerite svoj email za mijenjanje lozinke.</p>
        <div class="auth-links">
            <p class="mt-4 mb-0"><a asp-page="./Login">Nazad na prijavu</a></p>
        </div>
    </div>
</div>
