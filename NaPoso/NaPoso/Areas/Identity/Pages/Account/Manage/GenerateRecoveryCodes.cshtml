@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generiši oporavne kodove za 2FA";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="page-header">
    <h1><i class="bi bi-key me-2"></i>@ViewData["Title"]</h1>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <strong>Spremite ove kodove na sigurno mjesto.</strong>
    <p style="margin-top: var(--space-2);">
        Ako izgubite uređaj i nemate oporavne kodove, izgubit ćete pristup svom računu.
    </p>
    <p style="margin-bottom: 0;">
        Generisanje novih oporavnih kodova ne mijenja ključeve korištene u autentikacionim aplikacijama.
        Ako želite promijeniti ključ, trebali biste <a asp-page="./ResetAuthenticator">resetovati ključeve autentikatora</a>.
    </p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="content-card">
            <form method="post">
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-key me-1"></i>Generiši oporavne kodove
                </button>
            </form>
        </div>
    </div>
</div>
