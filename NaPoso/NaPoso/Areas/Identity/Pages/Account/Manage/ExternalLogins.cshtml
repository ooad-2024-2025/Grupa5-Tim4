@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Vanjske prijave";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<div class="page-header">
    <h1><i class="bi bi-link-45deg me-2"></i>@ViewData["Title"]</h1>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

@if (Model.CurrentLogins?.Count > 0)
{
    <h3>Registrovane prijave</h3>
    <div class="content-card">
        <table class="table">
            <thead>
                <tr>
                    <th>Davatelj usluge</th>
                    <th>Akcija</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var login in Model.CurrentLogins)
                {
                    <tr>
                        <td id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</td>
                        <td>
                            @if (Model.ShowRemoveButton)
                            {
                                <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                                    <div>
                                        <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                        <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                        <button type="submit" class="btn btn-danger btn-sm" title="Ukloni ovu prijavu @login.ProviderDisplayName sa vašeg računa">
                                            <i class="bi bi-x-lg me-1"></i>Ukloni
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                @: &nbsp;
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.OtherLogins?.Count > 0)
{
    <h3 class="mt-4">Dodajte drugi servis za prijavu</h3>
    <hr />
    <form id="link-login-form" asp-page-handler="LinkLogin" method="post">
        <div id="socialLoginList" class="d-flex gap-2 flex-wrap">
            @foreach (var provider in Model.OtherLogins)
            {
                <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn btn-secondary" name="provider" value="@provider.Name" title="Prijavite se pomoću vašeg @provider.DisplayName računa">
                    <i class="bi bi-box-arrow-in-right me-1"></i>@provider.DisplayName
                </button>
            }
        </div>
    </form>
}
