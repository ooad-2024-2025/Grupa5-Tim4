@page
@model EmailModel
@{
    ViewData["Title"] = "Upravljanje emailom";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="page-header">
    <h1><i class="bi bi-envelope me-2"></i>@ViewData["Title"]</h1>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-lg-6">
        <div class="content-card">
            <form id="email-form" method="post">
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                @if (Model.IsEmailConfirmed)
                {
                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Trenutni email</label>
                        <div class="input-group">
                            <input asp-for="Email" class="form-control" disabled />
                            <span class="input-group-text" style="background: var(--color-success-light); color: var(--color-success); border-color: var(--color-success);"><i class="bi bi-check-lg"></i></span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Trenutni email</label>
                        <input asp-for="Email" class="form-control" disabled />
                        <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-ghost btn-sm mt-2">
                            <i class="bi bi-send me-1"></i>Pošalji verifikacioni email
                        </button>
                    </div>
                }
                <div class="form-group">
                    <label asp-for="Input.NewEmail" class="form-label">Novi email</label>
                    <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="ime@primjer.com" />
                    <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                </div>
                <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Promijeni email
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
