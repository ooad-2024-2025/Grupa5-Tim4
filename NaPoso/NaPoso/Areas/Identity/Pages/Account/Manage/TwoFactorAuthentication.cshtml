@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Dvofaktorska autentifikacija (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="page-header">
    <h1><i class="bi bi-shield-lock me-2"></i>@ViewData["Title"]</h1>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>Nemate preostalih oporavnih kodova.</strong>
                    <p>Morate <a asp-page="./GenerateRecoveryCodes">generisati novi set oporavnih kodova</a> prije nego što se možete prijaviti pomoću oporavnog koda.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>Imate 1 preostali oporavni kod.</strong>
                    <p>Možete <a asp-page="./GenerateRecoveryCodes">generisati novi set oporavnih kodova</a>.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>Imate @Model.RecoveryCodesLeft preostalih oporavnih kodova.</strong>
                    <p>Trebali biste <a asp-page="./GenerateRecoveryCodes">generisati novi set oporavnih kodova</a>.</p>
                </div>
            }

            if (Model.IsMachineRemembered)
            {
                <form method="post" style="display: inline-block">
                    <button type="submit" class="btn btn-secondary">
                        <i class="bi bi-browser-chrome me-1"></i>Zaboravi ovaj preglednik
                    </button>
                </form>
            }
            <a asp-page="./Disable2fa" class="btn btn-danger">
                <i class="bi bi-shield-x me-1"></i>Onemogući 2FA
            </a>
            <a asp-page="./GenerateRecoveryCodes" class="btn btn-secondary">
                <i class="bi bi-key me-1"></i>Resetuj oporavne kodove
            </a>
        }

        <h3 class="mt-4">Autentikaciona aplikacija</h3>
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Dodaj autentikacionu aplikaciju
            </a>
        }
        else
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-secondary">
                <i class="bi bi-gear me-1"></i>Podesi autentikacionu aplikaciju
            </a>
            <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-ghost">
                <i class="bi bi-arrow-clockwise me-1"></i>Resetuj autentikacionu aplikaciju
            </a>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <strong>Politika privatnosti i kolačića nije prihvaćena.</strong>
            <p>Morate prihvatiti politiku prije nego što možete omogućiti dvofaktorsku autentifikaciju.</p>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
