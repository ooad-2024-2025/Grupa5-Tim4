@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Resetuj ključ autentikatora";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="page-header">
    <h1><i class="bi bi-arrow-clockwise me-2" style="color: var(--color-danger);"></i>@ViewData["Title"]</h1>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <strong>Ako resetujete ključ autentikatora, vaša autentikaciona aplikacija neće raditi dok je ponovo ne podesite.</strong>
    <p style="margin-top: var(--space-2); margin-bottom: 0;">
        Ovaj proces onemogućuje 2FA dok ponovo ne potvrdite svoju autentikacionu aplikaciju.
        Ako ne završite podešavanje, možete izgubiti pristup svom računu.
    </p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="content-card">
            <form id="reset-authenticator-form" method="post">
                <button id="reset-authenticator-button" class="btn btn-danger" type="submit">
                    <i class="bi bi-arrow-clockwise me-1"></i>Resetuj ključ autentikatora
                </button>
            </form>
        </div>
    </div>
</div>
