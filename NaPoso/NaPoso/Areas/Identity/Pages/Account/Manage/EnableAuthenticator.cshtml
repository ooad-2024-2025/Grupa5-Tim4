@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Podešavanje autentikacione aplikacije";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="page-header">
    <h1><i class="bi bi-shield-lock me-2"></i>@ViewData["Title"]</h1>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-lg-8">
        <div class="content-card">
            <p style="color: var(--color-text-secondary); font-size: var(--text-small); margin-bottom: var(--space-6);">
                Da biste koristili autentikacionu aplikaciju, pratite sljedeće korake:
            </p>

            <ol style="padding-left: var(--space-6); color: var(--color-text-secondary); font-size: var(--text-small);">
                <li style="margin-bottom: var(--space-6);">
                    <p style="margin-bottom: var(--space-2);">Preuzmite dvofaktorsku autentikacionu aplikaciju kao što je Microsoft Authenticator za
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> i
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> ili
                        Google Authenticator za
                        <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&hl=en">Android</a> i
                        <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
                    </p>
                </li>
                <li style="margin-bottom: var(--space-6);">
                    <p style="margin-bottom: var(--space-2);">Skenirajte QR kod ili unesite ključ <code style="background: var(--color-surface-hover); padding: 2px 6px; border-radius: 4px;">@Model.SharedKey</code> u vašu autentikacionu aplikaciju. Razmaci i velika/mala slova nisu važni.</p>
                    <div id="qrCode" style="margin: var(--space-4) 0;"></div>
                    <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
                </li>
                <li>
                    <p style="margin-bottom: var(--space-2);">Nakon što skenirate QR kod ili unesete ključ, vaša autentikaciona aplikacija će vam dati jedinstveni kod. Unesite kod u polje za potvrdu ispod.</p>
                </li>
            </ol>

            <form id="send-code" method="post" style="margin-top: var(--space-6);">
                <div class="form-group">
                    <label asp-for="Input.Code" class="form-label">Verifikacioni kod</label>
                    <input asp-for="Input.Code" class="form-control" autocomplete="off" aria-required="true" placeholder="Unesite 6-cifreni kod iz aplikacije" />
                    <span asp-validation-for="Input.Code" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Potvrdi
                </button>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3" role="alert"></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
