@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Lični podaci";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="page-header">
    <h1><i class="bi bi-database me-2"></i>@ViewData["Title"]</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="content-card">
            <p style="color: var(--color-text-secondary); font-size: var(--text-small);">
                Vaš račun sadrži lične podatke koje ste nam dostavili. Ova stranica vam omogućava da preuzmete ili obrišete te podatke.
            </p>
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Brisanje podataka će trajno ukloniti vaš račun, što se ne može oporaviti.</strong>
            </div>
            <div class="d-flex gap-3">
                <form id="download-data" asp-page="DownloadPersonalData" method="post">
                    <button class="btn btn-secondary" type="submit">
                        <i class="bi bi-download me-1"></i>Preuzmi podatke
                    </button>
                </form>
                <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>Obriši podatke
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
