@page
@model Disable2faModel
@{
    ViewData["Title"] = "Onemogući dvofaktorsku autentifikaciju (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="page-header">
    <h1><i class="bi bi-shield-x me-2" style="color: var(--color-danger);"></i>@ViewData["Title"]</h1>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <strong>Ova akcija samo onemogućuje 2FA.</strong>
    <p style="margin-top: var(--space-2); margin-bottom: 0;">
        Onemogućavanje 2FA ne mijenja ključeve korištene u autentikacionim aplikacijama.
        Ako želite promijeniti ključ, trebali biste <a asp-page="./ResetAuthenticator">resetovati ključeve autentikatora</a>.
    </p>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="content-card">
            <form method="post">
                <button class="btn btn-danger" type="submit">
                    <i class="bi bi-shield-x me-1"></i>Onemogući 2FA
                </button>
            </form>
        </div>
    </div>
</div>
