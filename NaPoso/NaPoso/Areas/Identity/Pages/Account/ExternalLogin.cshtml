@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Registracija";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-icon"><i class="bi bi-person-plus"></i></h1>
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Povežite svoj @Model.ProviderDisplayName račun</p>

        <p class="form-hint" style="text-align: center;">
            Uspješno ste se autentifikovali putem <strong>@Model.ProviderDisplayName</strong>.
            Unesite email adresu za ovu stranicu ispod i kliknite dugme za registraciju.
        </p>

        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">Email adresa</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="ime@primjer.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-primary btn-lg">
                <i class="bi bi-person-plus me-2"></i>Registruj se
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
