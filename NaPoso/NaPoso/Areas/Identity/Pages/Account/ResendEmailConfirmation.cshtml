@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Ponovo pošalji potvrdu emaila";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-icon"><i class="bi bi-envelope-arrow-up"></i></h1>
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Unesite svoj email za ponovno slanje potvrde</p>

        <form method="post">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">Email adresa</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ime@primjer.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-primary btn-lg">
                <i class="bi bi-send me-2"></i>Pošalji ponovo
            </button>
        </form>

        <div class="auth-links">
            <p class="mt-4 mb-0"><a asp-page="./Login">Nazad na prijavu</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
