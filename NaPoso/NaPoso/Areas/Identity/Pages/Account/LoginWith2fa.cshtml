@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Dvofaktorska autentifikacija";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-icon"><i class="bi bi-shield-check"></i></h1>
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Unesite kod iz vaše autentikacione aplikacije</p>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <input asp-for="RememberMe" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group">
                <label asp-for="Input.TwoFactorCode" class="form-label">Autentikacioni kod</label>
                <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" aria-required="true" placeholder="Unesite 6-cifreni kod" />
                <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.RememberMachine" class="form-label" style="display: flex; align-items: center; gap: var(--space-2); cursor: pointer;">
                    <input asp-for="Input.RememberMachine" style="width: auto;" />
                    Zapamti ovaj uređaj
                </label>
            </div>
            <button type="submit" class="w-100 btn btn-primary btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Prijavi se
            </button>
        </form>

        <div class="auth-links">
            <p class="mt-3 mb-0">
                Nemate pristup autentikacionoj aplikaciji?
                <a asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Prijavite se pomoću oporavnog koda</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
