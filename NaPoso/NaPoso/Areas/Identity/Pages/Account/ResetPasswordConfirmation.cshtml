@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Lozinka uspješno resetovana";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-icon"><i class="bi bi-check-circle"></i></h1>
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Vaša lozinka je uspješno promijenjena.</p>
        <div class="auth-links">
            <a asp-page="./Login" class="btn btn-primary btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Prijavite se
            </a>
        </div>
    </div>
</div>
