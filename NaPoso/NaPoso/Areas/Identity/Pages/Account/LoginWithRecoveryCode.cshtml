@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Prijava pomoću oporavnog koda";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-icon"><i class="bi bi-key"></i></h1>
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Unesite oporavni kod za prijavu</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-group">
                <label asp-for="Input.RecoveryCode" class="form-label">Oporavni kod</label>
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" aria-required="true" placeholder="Unesite oporavni kod" />
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-primary btn-lg">
                <i class="bi bi-box-arrow-in-right me-2"></i>Prijavi se
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
