@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Pristup odbijen";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-icon" style="color: var(--color-danger);"><i class="bi bi-shield-x"></i></h1>
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Nemate dozvolu za pristup ovoj stranici.</p>
        <p class="form-hint" style="text-align: center;">
            Vaša uloga ili dozvole ne dozvoljavaju pristup ovoj stranici.
            Ako mislite da je ovo greška, kontaktirajte administratora.
        </p>
        <div style="text-align: center; margin-top: var(--space-6);">
            <a href="/" class="btn btn-primary">
                <i class="bi bi-house me-1"></i>Nazad na početnu
            </a>
        </div>
    </div>
</div>
