@page
@model RegisterModel
@{
    ViewData["Title"] = "Registracija";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-icon"><i class="bi bi-person-plus"></i></h1>
        <h1>Registracija</h1>
        <p class="lead">Kreirajte novi račun</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="form-group">
                        <label asp-for="Input.Ime" class="form-label">Ime</label>
                        <input asp-for="Input.Ime" class="form-control" autocomplete="given-name" aria-required="true" placeholder="Vaše ime" />
                        <span asp-validation-for="Input.Ime" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        <label asp-for="Input.Prezime" class="form-label">Prezime</label>
                        <input asp-for="Input.Prezime" class="form-control" autocomplete="family-name" aria-required="true" placeholder="Vaše prezime" />
                        <span asp-validation-for="Input.Prezime" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">Email adresa</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ime@primjer.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.BrojTelefona" class="form-label">Broj telefona</label>
                <input asp-for="Input.BrojTelefona" class="form-control" autocomplete="tel" aria-required="true" placeholder="+387..." value="+387" />
                <span asp-validation-for="Input.BrojTelefona" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">Lozinka</label>
                <div class="password-wrapper">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Minimalno 6 karaktera" />
                    <button type="button" class="password-toggle" aria-label="Prikaži lozinku" tabindex="0">
                        <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="form-label">Potvrdi lozinku</label>
                <div class="password-wrapper">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Ponovite lozinku" />
                    <button type="button" class="password-toggle" aria-label="Prikaži lozinku" tabindex="0">
                        <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Uloga" class="form-label">Uloga</label>
                <select asp-for="Input.Uloga" class="form-select" aria-required="true">
                    <option value="">-- Odaberi ulogu --</option>
                    <option value="Klijent">Klijent</option>
                    <option value="Radnik">Radnik</option>
                </select>
                <span asp-validation-for="Input.Uloga" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-primary btn-lg">
                <i class="bi bi-person-plus me-2"></i>Registruj se
            </button>
        </form>

        <div class="auth-links">
            <p class="mt-4 mb-0">Već imate račun? <a asp-page="./Login">Prijavite se</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
