@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Potvrda registracije";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-icon"><i class="bi bi-envelope-arrow-up"></i></h1>
        <h1>@ViewData["Title"]</h1>
        @{
            if (@Model.DisplayConfirmAccountLink)
            {
                <p class="lead">Provjerite svoj email za potvrdu računa.</p>
                <p class="form-hint" style="text-align: center;">
                    Aplikacija trenutno nema podešen pravi email pošiljalac.
                    Normalno, ovo bi bilo poslano emailom:
                    <a id="confirm-link" href="@Model.EmailConfirmationUrl">Kliknite ovdje da potvrdite svoj račun</a>
                </p>
            }
            else
            {
                <p class="lead">Provjerite svoj email za potvrdu računa.</p>
            }
        }
        <div class="auth-links">
            <a asp-page="./Login" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right me-2"></i>Prijavite se
            </a>
        </div>
    </div>
</div>
