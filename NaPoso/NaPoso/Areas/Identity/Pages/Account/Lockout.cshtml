@page
@model LockoutModel
@{
    ViewData["Title"] = "Račun zaključan";
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-icon"><i class="bi bi-shield-lock"></i></h1>
        <h1>@ViewData["Title"]</h1>
        <p class="lead">Vaš račun je privremeno zaključan.</p>
        <p style="text-align: center; color: var(--color-text-muted); font-size: var(--text-small);">
            Molimo pokušajte ponovo kasnije.
        </p>
        <div class="auth-links">
            <a href="/" class="btn btn-primary">
                <i class="bi bi-house me-1"></i>Nazad na početnu
            </a>
        </div>
    </div>
</div>
