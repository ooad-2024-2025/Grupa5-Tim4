@model ErrorViewModel
@{
    ViewData["Title"] = "Greška";
}

<div class="auth-container">
    <div class="auth-card text-center">
        <h1 class="auth-icon" style="color: var(--color-danger);"><i class="bi bi-exclamation-triangle"></i></h1>
        <h1 style="color: var(--color-danger);">Došlo je do greške</h1>
        <p class="lead">Nešto je pošlo po zlu prilikom obrade vašeg zahtjeva.</p>

        @if (Model.ShowRequestId)
        {
            <div class="content-card mt-4" style="text-align: left;">
                <small class="text-muted"><strong>Request ID:</strong> <code>@Model.RequestId</code></small>
            </div>
        }

        <div class="mt-6">
            <a href="/" class="btn btn-primary">
                <i class="bi bi-house me-1"></i>Nazad na početnu
            </a>
        </div>
    </div>
</div>
