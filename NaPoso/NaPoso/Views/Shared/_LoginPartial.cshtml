@using Microsoft.AspNetCore.Identity
@inject SignInManager<Korisnik> SignInManager
@inject UserManager<Korisnik> UserManager

<div class="d-flex align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Okidač za korisnički meni (u Navbaru) -->
        <button class="btn btn-outline-secondary border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#userOffcanvas" aria-controls="userOffcanvas">
            <i class="bi bi-list fs-3"></i>
        </button>
    }
    else
    {
        <a class="btn btn-outline-secondary px-4 py-2 fw-semibold border-0 rounded-pill" asp-area="Identity" asp-page="/Account/Register">
            <i class="bi bi-person-plus me-1"></i>Registracija
        </a>
        <a class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Prijava
        </a>
    }
</div>
