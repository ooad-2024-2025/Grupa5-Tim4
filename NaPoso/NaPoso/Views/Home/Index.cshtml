@{
    ViewData["Title"] = "Početna stranica";
}

<section class="hero-section animate-fade-in-up" style="position: relative; overflow: hidden;">
    <div class="hero-copy" style="position: relative; z-index: 1;">
        <span class="hero-eyebrow"><i class="bi bi-graph-up-arrow"></i> Profesionalno tržište poslova</span>
        <h1>Brzo objavi posao ili pronađi pravog čovjeka za njega.</h1>
        <p>NaPoso povezuje klijente i radnike u jednom sigurnom toku: od oglasa i prijave, preko komunikacije, do plaćanja i recenzija.</p>

        <div class="hero-actions">
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg">
                    <i class="bi bi-rocket-takeoff me-2"></i>Kreiraj nalog
                </a>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-secondary btn-lg">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Prijava
                </a>
            }
            else
            {
                @if (User.IsInRole("Radnik"))
                {
                    <a asp-controller="Home" asp-action="Radnik" class="btn btn-primary btn-lg shadow-sm hover-lift">
                        <i class="bi bi-speedometer2 me-2"></i>Idi na dashboard
                    </a>
                }
                else if (User.IsInRole("Klijent"))
                {
                    <a asp-controller="Home" asp-action="Klijent" class="btn btn-primary btn-lg shadow-sm hover-lift">
                        <i class="bi bi-speedometer2 me-2"></i>Idi na dashboard
                    </a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-primary btn-lg shadow-sm hover-lift">
                        <i class="bi bi-speedometer2 me-2"></i>Idi na dashboard
                    </a>
                }
            }
        </div>
    </div>

    <div class="hero-side-panel">
        <div class="hero-side-card">
            <div style="display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-3);">
                <img src="~/images/hero.png" alt="NaPoso Platforma" class="img-fluid rounded-3" style="max-height: 60px; object-fit: contain; opacity: 0.9;" />
                <h3 style="margin: 0;">Kako izgleda rad kroz platformu</h3>
            </div>
            <ul class="hero-points">
                <li><i class="bi bi-1-circle-fill"></i><span>Kreiraš oglas ili pregledaš aktivne poslove.</span></li>
                <li><i class="bi bi-2-circle-fill"></i><span>Komuniciraš direktno kroz razgovore bez prebacivanja na druge alate.</span></li>
                <li><i class="bi bi-3-circle-fill"></i><span>Zaključiš posao uz pregled statusa, recenzije i sigurnu isplatu.</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="trust-section">
    <div class="trust-section-header">
        <h2 class="trust-section-title"><i class="bi bi-stars me-2"></i>Zašto NaPos'o</h2>
        <p class="trust-section-subtitle">Tri ključna prednosti koja platformu čine brzom, sigurnom i jasnom za sve korisnike.</p>
    </div>
    <div class="trust-row">
        <div class="hero-trust-item">
            <div class="hero-trust-icon">
                <i class="bi bi-lightning-charge-fill"></i>
            </div>
            <div class="hero-trust-value">Brzo</div>
            <div class="hero-trust-label">Objavljivanje</div>
        </div>
        <div class="hero-trust-item">
            <div class="hero-trust-icon">
                <i class="bi bi-shield-fill-check"></i>
            </div>
            <div class="hero-trust-value">Sigurno</div>
            <div class="hero-trust-label">Plaćanje</div>
        </div>
        <div class="hero-trust-item">
            <div class="hero-trust-icon">
                <i class="bi bi-bar-chart-line-fill"></i>
            </div>
            <div class="hero-trust-value">Jasno</div>
            <div class="hero-trust-label">Praćenje</div>
        </div>
    </div>
</section>

<section class="feature-grid section-gap">
    <div class="feature-card animate-fade-in-up">
        <div class="feature-card-icon">
            <i class="bi bi-megaphone"></i>
        </div>
        <h3>Oglašavaj poslove</h3>
        <p>Kreiraj oglase, postavi uslove i pronađi idealnog radnika za svoj projekat.</p>
    </div>
    <div class="feature-card animate-fade-in-up">
        <div class="feature-card-icon">
            <i class="bi bi-search"></i>
        </div>
        <h3>Pronađi posao</h3>
        <p>Pretraži dostupne poslove po lokaciji, tipu i cijeni. Prijavi se jednim klikom.</p>
    </div>
    <div class="feature-card animate-fade-in-up">
        <div class="feature-card-icon">
            <i class="bi bi-shield-check"></i>
        </div>
        <h3>Sigurno plaćanje</h3>
        <p>Sigurna integracija plaćanja osigurava zaštićeno plaćanje za obavljene poslove.</p>
    </div>
    <div class="feature-card animate-fade-in-up">
        <div class="feature-card-icon">
            <i class="bi bi-chat-dots"></i>
        </div>
        <h3>Real-time komunikacija</h3>
        <p>Četuj sa klijentima ili radnicima direktno kroz platformu.</p>
    </div>
    <div class="feature-card animate-fade-in-up">
        <div class="feature-card-icon">
            <i class="bi bi-star"></i>
        </div>
        <h3>Sistem recenzija</h3>
        <p>Ocjenjuj saradnike i gradi reputaciju kroz provjerene recenzije.</p>
    </div>
    <div class="feature-card animate-fade-in-up">
        <div class="feature-card-icon">
            <i class="bi bi-clipboard-check"></i>
        </div>
        <h3>Verifikacija dokumenata</h3>
        <p>Verifikuj svoj identitet i stekni povjerenje klijenata ili radnika.</p>
    </div>
</section>
