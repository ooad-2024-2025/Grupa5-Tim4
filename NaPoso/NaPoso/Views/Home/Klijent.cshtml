@{
    ViewData["Title"] = "Klijentski dashboard";
    var ukupnoPotroseno = (ViewBag.UkupnoPotroseno as decimal?) ?? 0m;
    var ukupniBaksis = (ViewBag.UkupniBaksis as decimal?) ?? 0m;
    var osnovicaPotrosena = (ViewBag.OsnovicaPotrosena as decimal?) ?? 0m;
    var godisnjaUkupno = (ViewBag.GodišnjaPotrošnjaUkupno as double?) ?? 0.0;
    var prosjecnaMjesecna = (ViewBag.ProsječnaMjesečnaPotrošnja as decimal?) ?? 0m;
    var godisnjaJson = (ViewBag.GodišnjaPotrošnjaJson as string) ?? "[]";
    var godina = DateTime.Now.Year;
}

<div class="page-header">
    <span class="hero-eyebrow mb-3"><i class="bi bi-person-workspace"></i> Klijent</span>
    <h1>Dobrodošli, klijentu!</h1>
    <p class="lead mt-2">Objavite poslove, pratite prijave i upravljajte saradnjom bez lutanja kroz meni.</p>
</div>

<div class="row g-4 mb-5 animate-fade-in-up align-items-stretch">
    <div class="col-md-4 d-flex">
        <div class="stat-card shadow-sm hover-lift w-100">
            <i class="bi bi-megaphone stat-icon"></i>
            <div class="stat-value">@ViewBag.AktivniOglasi</div>
            <div class="stat-label fw-bold">Aktivni oglasi</div>
            <div class="stat-detail">
                <span class="stat-detail-item">Trenutno u toku</span>
            </div>
        </div>
    </div>
    <div class="col-md-4 d-flex">
        <div class="stat-card shadow-sm hover-lift w-100">
            <i class="bi bi-check2-circle stat-icon"></i>
            <div class="stat-value">@ViewBag.ZavrseniOglasi</div>
            <div class="stat-label fw-bold">Završeni oglasi</div>
            <div class="stat-detail">
                <span class="stat-detail-item">Uspješno obavljeni</span>
            </div>
        </div>
    </div>
    <div class="col-md-4 d-flex">
        <div class="stat-card stat-card-primary shadow-sm hover-lift w-100">
            <i class="bi bi-wallet2 stat-icon"></i>
            <div class="stat-value"><span class="amount-nowrap">@ukupnoPotroseno KM</span> <span class="badge badge-soft-accent fs-6 align-middle ms-2" style="font-size:0.85rem; vertical-align: middle !important;">Sve vrijeme</span></div>
            <div class="stat-label fw-bold">Ukupno isplaćeno radnicima</div>
            <div class="stat-detail flex-wrap" style="gap:0.5rem 1rem;">
                <span class="stat-detail-item">
                    <i class="bi bi-wallet me-1"></i>Osnovica: @osnovicaPotrosena KM
                </span>
                <span class="stat-detail-item text-success fw-semibold">
                    <i class="bi bi-gift me-1"></i>Bakšiš: @ukupniBaksis KM
                </span>
            </div>
        </div>
    </div>
</div>

<div class="content-card section-gap mb-5">
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-8">
            <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
                <div>
                    <span class="hero-eyebrow mb-2 d-block"><i class="bi bi-graph-up"></i> Analiza potrošnje</span>
                    <h2 class="h3 mb-0">Potrošnja tokom @godina. godine</h2>
                    <p class="text-muted mb-0 mt-1">Prikaz ukupne potrošnje po mjesecu (osnovica + bakšiš)</p>
                </div>
            </div>
            <div style="position: relative; height: 380px; width: 100%;">
                <canvas id="godisnjaPotrosnjaChart"></canvas>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="d-flex flex-column gap-3 h-100">
                <div class="stat-card h-100 mb-0" style="border-left:4px solid var(--color-accent);">
                    <i class="bi bi-cash-stack stat-icon" style="color:var(--color-accent);"></i>
                    <div class="stat-value"><span class="amount-nowrap">@(Math.Round(godisnjaUkupno, 2)) KM</span></div>
                    <div class="stat-label fw-bold">Ukupna potrošnja @godina.</div>
                    <div class="stat-detail">
                        <span class="stat-detail-item">Sve isplate u tekućoj godini</span>
                    </div>
                </div>
                <div class="stat-card h-100 mb-0" style="border-left:4px solid var(--brand-accent);">
                    <i class="bi bi-calendar3 stat-icon" style="color:var(--brand-accent);"></i>
                    <div class="stat-value"><span class="amount-nowrap">@prosjecnaMjesecna KM</span></div>
                    <div class="stat-label fw-bold">Prosječna mjesečna potrošnja</div>
                    <div class="stat-detail">
                        <span class="stat-detail-item">
                            <i class="bi bi-bar-chart-line me-1"></i>
                            Prosjek za @godina. godinu
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="feature-grid">
    <a asp-controller="Oglas" asp-action="Create" class="text-decoration-none d-block">
        <article class="feature-card h-100">
            <div class="feature-card-icon">
                <i class="bi bi-plus-circle"></i>
            </div>
            <h3>Objavi oglas</h3>
            <p>Kreirajte novi oglas i odmah otvorite kanal za prijave od provjerenih radnika.</p>
        </article>
    </a>
    <a asp-controller="Oglas" asp-action="OglasiKlijenta" class="text-decoration-none d-block">
        <article class="feature-card h-100">
            <div class="feature-card-icon">
                <i class="bi bi-list-check"></i>
            </div>
            <h3>Moji oglasi</h3>
            <p>Pratite statuse svojih oglasa, pregledajte prijavljene radnike i upravljajte narednim koracima.</p>
        </article>
    </a>
    <a asp-controller="Chat" asp-action="Index" class="text-decoration-none d-block">
        <article class="feature-card h-100">
            <div class="feature-card-icon">
                <i class="bi bi-chat-dots"></i>
            </div>
            <h3>Razgovori</h3>
            <p>Komunicirajte sa radnicima direktno iz jednog preglednog mjesta, bez prebacivanja između ekrana.</p>
        </article>
    </a>
</section>

<section class="content-card section-gap">
    <div class="row g-4 align-items-center">
        <div class="col-lg-7">
            <h2 class="h3 mb-3">Preporučeni slijed rada</h2>
            <div class="d-grid gap-3">
                <div class="d-flex gap-3 align-items-start">
                    <span class="badge badge-soft-primary">1</span>
                    <div>
                        <strong>Kreirajte jasan oglas.</strong>
                        <p class="mb-0">Dodajte opis, cijenu i lokaciju kako bi se pravi ljudi mogli prijaviti odmah.</p>
                    </div>
                </div>
                <div class="d-flex gap-3 align-items-start">
                    <span class="badge badge-soft-primary">2</span>
                    <div>
                        <strong>Pratite prijave i razgovore.</strong>
                        <p class="mb-0">Brzo filtrirajte prijavljene radnike i dogovorite detalje kroz chat.</p>
                    </div>
                </div>
                <div class="d-flex gap-3 align-items-start">
                    <span class="badge badge-soft-primary">3</span>
                    <div>
                        <strong>Završite posao i zabilježite ishod.</strong>
                        <p class="mb-0">Status oglasa, plaćanje i recenzije ostaju uredno objedinjeni u istoj platformi.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="hero-side-card">
                <h3>Brzi pristup</h3>
                <p class="mb-3">Ovo su najvažnije stvari koje tipično trebate odmah nakon prijave.</p>
                <ul class="hero-points">
                    <li><i class="bi bi-pencil-square"></i><span>Kreiranje novog oglasa</span></li>
                    <li><i class="bi bi-people"></i><span>Pregled prijavljenih radnika</span></li>
                    <li><i class="bi bi-chat-dots"></i><span>Otvoreni razgovori sa kandidatima</span></li>
                </ul>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mjeseci = ['Jan', 'Feb', 'Mar', 'Apr', 'Maj', 'Jun', 'Jul', 'Avg', 'Sep', 'Okt', 'Nov', 'Dec'];
            const podaci = @Html.Raw(godisnjaJson);

            const ctx = document.getElementById('godisnjaPotrosnjaChart').getContext('2d');

            const gradient = ctx.createLinearGradient(0, 0, 0, 400);
            gradient.addColorStop(0, '#FF3D68');
            gradient.addColorStop(1, '#00E0B8');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: mjeseci,
                    datasets: [{
                        label: 'Potrošnja (KM)',
                        data: podaci,
                        backgroundColor: gradient,
                        borderRadius: 10,
                        borderSkipped: false,
                        borderWidth: 1,
                        borderColor: '#FF3D68',
                        hoverBackgroundColor: '#FF3D68',
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(14, 59, 54, 0.95)',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            borderColor: '#FF3D68',
                            borderWidth: 2,
                            padding: 12,
                            displayColors: false,
                            callbacks: {
                                label: (c) => `${Number(c.raw).toFixed(2)} KM`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: (v) => v + ' KM',
                                precision: 0,
                                font: { weight: '500' }
                            },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        x: {
                            ticks: { font: { weight: '500' } },
                            grid: { display: false }
                        }
                    }
                }
            });
        });
    </script>
}
