@model NaPoso.Models.Obavijest

@{
    ViewData["Title"] = "Obriši obavijest";
}

<div class="page-header page-header-danger">
    <h1><i class="bi bi-trash me-2"></i>Obriši obavijest</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Da li ste sigurni da želite obrisati ovu obavijest?
        </div>

        <div class="content-card">
            <dl class="row mb-0">
                <dt class="col-sm-3">Korisnik</dt>
                <dd class="col-sm-9"><code style="font-size: var(--text-caption);">@Model.KorisnikId</code></dd>

                <dt class="col-sm-3">Sadržaj</dt>
                <dd class="col-sm-9">@Model.Sadrzaj</dd>

                <dt class="col-sm-3">Vrijeme</dt>
                <dd class="col-sm-9">@Model.VrijemeSlanja.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-3">Tip</dt>
                <dd class="col-sm-9"><span class="badge bg-info">@Model.Tip</span></dd>
            </dl>
        </div>

        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Obriši</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
            </div>
        </form>
    </div>
</div>
