@model NaPoso.Models.Chat
@using Microsoft.AspNetCore.Identity
@inject UserManager<Korisnik> UserManager
@{
    ViewData["Title"] = "Poruke";
    var currentUserId = UserManager.GetUserId(User);
}

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="page-header">
    <h1><i class="bi bi-chat-dots me-2"></i>Razgovor - @Model.Oglas.Naslov</h1>
    <p class="lead">
        <strong>@Model.Korisnik1.Ime @Model.Korisnik1.Prezime</strong> &leftrightarrow;
        <strong>@Model.Korisnik2.Ime @Model.Korisnik2.Prezime</strong>
    </p>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<div class="content-card">
    <div class="chat-box">
        @if (!Model.Poruke.Any())
        {
            <div class="empty-state" style="padding: var(--space-6);">
                <p>Nema još poruka u ovom razgovoru.</p>
            </div>
        }
        else
        {
            @foreach (var poruka in Model.Poruke.OrderBy(p => p.PoslanoAt))
            {
                var isMine = poruka.PosiljaocId == currentUserId;
                if (isMine)
                {
                    <div class="chat-row chat-row-mine">
                        <div class="chat-bubble chat-bubble-mine">
                            <div class="chat-sender chat-sender-mine">Ti</div>
                            <div class="chat-text chat-text-mine">@poruka.Tekst</div>
                            <div class="chat-time chat-time-mine">@poruka.PoslanoAt.ToString("HH:mm dd.MM.yyyy")</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="chat-row chat-row-other">
                        <div class="chat-bubble chat-bubble-other">
                            <div class="chat-sender chat-sender-other">@poruka.Posiljaoc.Ime</div>
                            <div class="chat-text chat-text-other">@poruka.Tekst</div>
                            <div class="chat-time chat-time-other">@poruka.PoslanoAt.ToString("HH:mm dd.MM.yyyy")</div>
                        </div>
                    </div>
                }
            }
        }
    </div>

    <form method="post" asp-action="PosaljiPoruku" class="mt-4">
        <input type="hidden" name="chatId" value="@Model.Id" />
        <div class="d-flex gap-3 align-items-stretch flex-column flex-sm-row mobile-stack-actions">
            <textarea name="tekst" class="form-control" placeholder="Unesi poruku..." required rows="2" style="resize:none; min-height: 48px;"></textarea>
            <button type="submit" class="btn btn-primary" style="height: 48px; white-space: nowrap; flex-shrink: 0;">
                <i class="bi bi-send me-1"></i>Pošalji
            </button>
        </div>
    </form>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad na razgovore</a>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var chatMessages = $(".chat-messages");
            chatMessages.scrollTop(chatMessages[0].scrollHeight);
        });
    </script>
}
