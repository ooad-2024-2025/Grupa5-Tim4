@model NaPoso.Models.Recenzija

@{
    ViewData["Title"] = "Detalji recenzije";
}

<div class="page-header">
    <h1><i class="bi bi-info-circle me-2"></i>Detalji recenzije</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="content-card">
            <dl class="row mb-0">
                <dt class="col-sm-3">Ocjena</dt>
                <dd class="col-sm-9"><strong class="text-accent" style="font-size: var(--text-h3);">@Model.Ocjena / 5</strong></dd>

                <dt class="col-sm-3">Sadržaj</dt>
                <dd class="col-sm-9">@Model.Sadrzaj</dd>
            </dl>
        </div>

        <div class="d-flex gap-3 mt-4">
            @if (User.IsInRole(NaPoso.Constants.RoleConstants.Admin))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Uredi</a>
            }
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
        </div>
    </div>
</div>
