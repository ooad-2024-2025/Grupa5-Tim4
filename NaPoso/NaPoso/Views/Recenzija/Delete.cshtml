@model NaPoso.Models.Recenzija

@{
    ViewData["Title"] = "Obriši recenziju";
}

<div class="page-header page-header-danger">
    <h1><i class="bi bi-trash me-2"></i>Obriši recenziju</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Da li ste sigurni da želite obrisati ovu recenziju?
        </div>

        <div class="content-card">
            <dl class="row mb-0">
                <dt class="col-sm-3">Ocjena</dt>
                <dd class="col-sm-9"><strong>@Model.Ocjena / 5</strong></dd>

                <dt class="col-sm-3">Sadržaj</dt>
                <dd class="col-sm-9">@Model.Sadrzaj</dd>
            </dl>
        </div>

        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Obriši</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
            </div>
        </form>
    </div>
</div>
