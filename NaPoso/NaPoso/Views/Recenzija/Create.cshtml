@model NaPoso.Models.Recenzija
@{
    ViewData["Title"] = "Ostavi recenziju";
}

<div class="page-header">
    <h1><i class="bi bi-star me-2"></i>Ostavi recenziju</h1>
</div>

<div class="row">
    <div class="col-lg-7 mx-auto">
        <div class="content-card">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }

                <input type="hidden" asp-for="RadnikId" />

                <div class="form-group mb-4">
                    <label class="form-label">Ocjena (1-5)</label>
                    <div class="star-rating">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <input type="radio" id="star@(i)" name="Ocjena" value="@i" required />
                            <label for="star@(i)" title="@i stars"><i class="bi bi-star-fill"></i></label>
                        }
                    </div>
                    <span asp-validation-for="Ocjena" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Sadrzaj" class="form-label">Vaš komentar</label>
                    <textarea asp-for="Sadrzaj" class="form-control" rows="5" placeholder="Opišite svoje iskustvo..."></textarea>
                    <span asp-validation-for="Sadrzaj" class="text-danger"></span>
                </div>

                @if (Context.Request.Query.ContainsKey("oglasId"))
                {
                    <input type="hidden" name="oglasId" value="@Context.Request.Query["oglasId"]" />
                }

                <div class="d-flex gap-3 mt-4 flex-column flex-sm-row mobile-stack-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Pošalji recenziju</button>
                    <a href="javascript:history.back()" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
