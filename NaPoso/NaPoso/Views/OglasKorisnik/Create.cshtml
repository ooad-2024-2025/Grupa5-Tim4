@model NaPoso.Models.OglasKorisnik

@{
    ViewData["Title"] = "Kreiraj prijavu";
}

<div class="page-header">
    <h1><i class="bi bi-clipboard-check me-2"></i>Kreiraj prijavu</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="content-card">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="form-group">
                    <label asp-for="KorisnikId" class="form-label">Korisnik ID</label>
                    <input asp-for="KorisnikId" class="form-control" />
                    <span asp-validation-for="KorisnikId" class="text-danger"></span>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Kreiraj</button>
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
