@model NaPoso.Models.Korisnik

@{
    ViewData["Title"] = "Stripe Connect — Status";
}

<div class="page-header">
    <h1><i class="bi bi-wallet2 me-2"></i>Stripe Connect</h1>
    <p class="lead">Upravljajte isplatama za obavljene poslove</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle me-2"></i>@TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-4">
                    <i class="bi bi-shield-check me-2"></i>Status naloga
                </h5>

                @if (string.IsNullOrEmpty(Model?.StripeConnectedAccountId))
                {
                    <!-- Nema accounta -->
                    <div class="text-center py-4">
                        <i class="bi bi-person-plus display-1 text-muted"></i>
                        <h4 class="mt-3">Još niste povezali Stripe nalog</h4>
                        <p class="text-muted mb-4">
                            Da biste primali isplate za obavljene poslove, potrebno je da kreirate Stripe Express nalog
                            i unesete vaše bankovne podatke.
                        </p>
                        <a asp-action="Onboarding" class="btn btn-primary btn-lg">
                            <i class="bi bi-link-45deg me-2"></i>Poveži Stripe nalog
                        </a>
                    </div>
                }
                else if (!Model.StripeOnboardingCompleted)
                {
                    <!-- Onboarding nije završen -->
                    <div class="text-center py-4">
                        <i class="bi bi-hourglass-split display-1 text-warning"></i>
                        <h4 class="mt-3">Onboarding u toku</h4>
                        <p class="text-muted mb-4">
                            Vaš Stripe nalog je kreiran, ali niste završili unos podataka.
                            Kliknite ispod da nastavite.
                        </p>
                        <a asp-action="Onboarding" class="btn btn-primary btn-lg">
                            <i class="bi bi-arrow-right-circle me-2"></i>Nastavi onboarding
                        </a>
                    </div>
                }
                else if (!Model.PayoutsEnabled)
                {
                    <!-- Čeka se verifikacija -->
                    <div class="text-center py-4">
                        <i class="bi bi-clock-history display-1" style="color: var(--brand-primary-light);"></i>
                        <h4 class="mt-3">Čeka se verifikacija</h4>
                        <p class="text-muted mb-4">
                            Vaši podaci su poslani. Stripe provjerava vaše informacije.
                            Isplate će biti omogućene čim se verifikacija završi.
                        </p>
                        <span class="badge bg-info fs-6">
                            <i class="bi bi-clock me-1"></i>Verifikacija u toku
                        </span>
                    </div>
                }
                else
                {
                    <!-- Sve OK -->
                    <div class="text-center py-4">
                        <i class="bi bi-check-circle display-1 text-success"></i>
                        <h4 class="mt-3">Nalog aktivan</h4>
                        <p class="text-muted mb-4">
                            Vaš Stripe nalog je potpuno aktivan. Možete primati isplate za obavljene poslove.
                        </p>
                        <span class="badge bg-success fs-6">
                            <i class="bi bi-check-lg me-1"></i>Isplate omogućene
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="bi bi-info-circle me-2"></i>Informacije
                </h5>

                <div class="mb-3">
                    <small class="text-muted">Stripe Account ID</small>
                    <div class="fw-bold">
                        @(string.IsNullOrEmpty(Model?.StripeConnectedAccountId) ? "—" : Model.StripeConnectedAccountId)
                    </div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Onboarding</small>
                    <div>
                        @if (Model?.StripeOnboardingCompleted == true)
                        {
                            <span class="badge bg-success">Završen</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nije završen</span>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <small class="text-muted">Isplate</small>
                    <div>
                        @if (Model?.PayoutsEnabled == true)
                        {
                            <span class="badge bg-success">Omogućene</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Onemogućene</span>
                        }
                    </div>
                </div>

                <hr />

                <div class="small text-muted">
                    <p><i class="bi bi-question-circle me-1"></i><strong>Kako radi?</strong></p>
                    <ol class="ps-3">
                        <li>Kreirate Stripe Express nalog</li>
                        <li>Unesete bankovne podatke</li>
                        <li>Stripe verifikuje vaše informacije</li>
                        <li>Kada klijent plati i potvrdi posao, novac se automatski transferiše na vaš račun</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</div>
