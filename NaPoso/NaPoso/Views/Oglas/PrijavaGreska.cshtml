@{
    ViewData["Title"] = "Greška prilikom prijave";
}

<div class="auth-container">
    <div class="auth-card text-center">
        <h1 class="auth-icon" style="color: var(--color-danger);"><i class="bi bi-exclamation-circle-fill"></i></h1>
        <h1 style="color: var(--color-danger);">Greška prilikom prijave</h1>
        <p class="lead">Posao je već zauzet ili je oglas zatvoren.</p>
        <p class="form-hint" style="text-align: center;">Niste uspjeli da se prijavite na ovaj posao.</p>

        <div class="mt-4">
            <a asp-controller="Oglas" asp-action="PrikazOglasa" class="btn btn-primary">
                <i class="bi bi-arrow-left me-1"></i>Nazad na dostupne poslove
            </a>
        </div>
    </div>
</div>
