@model IEnumerable<NaPoso.Models.VerifikovanView>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Oglasi za radnike";
    var searchValue = (string)ViewContext.HttpContext.Request.Query["search"];
    var prijavljeni = ViewBag.PrijavljeniOglasiId as List<int>;
}

<div class="page-header">
    <h1><i class="bi bi-search me-2"></i>Aktivni oglasi</h1>
    <p class="lead">Pronađite posao koji vam odgovara</p>
</div>

<div class="content-card mb-6">
    @Html.AntiForgeryToken()
    <form method="get" asp-action="PrikazOglasa" class="mb-3">
        <label class="form-label mb-2">Pretraga</label>
        <div class="input-group">
            <input type="text" name="search" class="form-control" placeholder="Pretraga po naslovu ili opisu..." value="@searchValue" />
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-search me-1"></i>Pretraži
            </button>
        </div>
    </form>

    <button id="toggleFiltersBtn" class="btn btn-ghost btn-sm mt-3">
        <i class="bi bi-funnel me-1"></i>Filteri
    </button>

    <form id="filterForm" method="get" asp-action="PrikazOglasa" class="mt-3" style="display:none;">
        <div class="row g-3">
            <div class="col-md-3">
                <input type="text" name="lokacija" class="form-control" placeholder="Lokacija"
                       value="@HttpContextAccessor.HttpContext.Request.Query["lokacija"]"
                       id="lokacijaInput" />
            </div>
            <div class="col-md-2">
                <input type="text" id="minCijenaInput" name="minCijena" class="form-control" placeholder="Min cijena"
                       value="@HttpContextAccessor.HttpContext.Request.Query["minCijena"]" />
            </div>
            <div class="col-md-2">
                <input type="text" id="maxCijenaInput" name="maxCijena" class="form-control" placeholder="Max cijena"
                       value="@HttpContextAccessor.HttpContext.Request.Query["maxCijena"]" />
            </div>
            <div class="col-md-3">
                <select name="sort" class="form-select">
                    <option value="">Sortiraj po</option>
                    <option value="cijena_asc">Cijena - Rastuće</option>
                    <option value="cijena_desc">Cijena - Opadajuće</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i>Filtriraj
                </button>
            </div>
        </div>
    </form>
    
    <hr class="my-4" style="border-color: var(--color-border);" />

<script>
    document.getElementById("toggleFiltersBtn").addEventListener("click", function () {
        const form = document.getElementById("filterForm");
        form.style.display = (form.style.display === "none") ? "block" : "none";
    });

    document.getElementById("minCijenaInput").addEventListener("input", function (e) {
        this.value = this.value.replace(/[^0-9]/g, '');
    });
    document.getElementById("maxCijenaInput").addEventListener("input", function (e) {
        this.value = this.value.replace(/[^0-9]/g, '');
    });
    document.getElementById("lokacijaInput").addEventListener("input", function () {
        this.value = this.value.replace(/[^A-Za-zšđčćžŠĐČĆŽ\s]/g, '');
    });
</script>

@if (!Model.Any())
{
    <div class="empty-state animate-fade-in-up">
        <svg class="empty-state-svg mb-3" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-muted); opacity: 0.5;">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
            <path d="M8 14h.01"></path>
            <path d="M12 14h.01"></path>
            <path d="M16 14h.01"></path>
            <path d="M8 18h.01"></path>
            <path d="M12 18h.01"></path>
            <path d="M16 18h.01"></path>
        </svg>
        <h3>Nema aktivnih oglasa</h3>
        <p>Trenutno nema dostupnih oglasa koji odgovaraju vašim kriterijima.</p>
        <button class="btn btn-primary mt-3" onclick="window.location.href='@Url.Action("PrikazOglasa")'">Očistite filtere</button>
    </div>
}
else
{
    <div class="row g-4 animate-fade-in-up" style="animation-delay: 0.1s;">
        @{ int delayCounter = 2; }
        @foreach (var oglas in Model)
        {
            <div class="col-12" style="animation-delay: @(delayCounter * 0.05)s;">
                <div class="content-card h-100" style="cursor: pointer; padding: var(--space-5);" onclick="window.location='@Url.Action("Details", new { id = oglas.Oglas.Id })'">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <h4 class="mb-0">@oglas.Oglas.Naslov</h4>
                                @if (oglas.Verifikovan)
                                {
                                    <span class="badge badge-soft-success" title="Verifikovan korisnik"><i class="bi bi-check-circle me-1"></i>Verifikovan</span>
                                }
                            </div>
                            <p class="text-muted mb-2" style="font-size: var(--text-small);">@oglas.Oglas.Opis</p>
                            <div class="d-flex align-items-center gap-4 text-muted" style="font-size: var(--text-caption);">
                                <span><i class="bi bi-geo-alt me-1"></i>@LokacijaHelper.UGradu(oglas.Oglas.Lokacija)</span>
                            </div>
                        </div>
                        <div class="d-flex flex-md-column align-items-md-end align-items-center justify-content-between gap-3" style="min-width: 150px;">
                            <div class="text-accent fs-4 fw-bold">@oglas.Oglas.CijenaPosla KM</div>
                            @if (prijavljeni != null && prijavljeni.Contains(oglas.Oglas.Id))
                            {
                                <div class="text-success fw-semibold" style="font-size: var(--text-caption);">
                                    <i class="bi bi-check-circle-fill me-1"></i>Prijavljeni ste
                                </div>
                            }
                            else if (User.IsInRole("Radnik"))
                            {
                                <button type="button"
                                        class="btn btn-primary btn-sm px-4 prijavi-se-btn"
                                        data-oglas-id="@oglas.Oglas.Id"
                                        onclick="event.stopPropagation()">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Prijavi se
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
            delayCounter++;
        }
    </div>
}
</div>

@section Scripts {
<script>
(function () {
    var csrfField = document.querySelector('input[name="__RequestVerificationToken"]');
    var csrfToken = csrfField ? csrfField.value : '';

    function showNaposoToast(poruka, tip) {
        if (!tip) tip = 'success';
        var container = document.getElementById('toastContainer') || document.querySelector('.toast-container');
        if (!container) {
            container = document.createElement('div');
            container.className = 'toast-container position-fixed p-3';
            container.id = 'toastContainer';
            container.style.bottom = '0';
            container.style.right = '0';
            container.style.zIndex = '9999';
            document.body.appendChild(container);
        }

        var toastEl = document.createElement('div');
        var isSuccess = tip === 'success';
        toastEl.className = 'toast align-items-center border-0 mb-2';
        toastEl.setAttribute('role', 'alert');
        toastEl.setAttribute('aria-live', 'assertive');
        toastEl.style.minWidth = '320px';
        toastEl.style.backgroundColor = isSuccess ? 'var(--status-success-light, #e6fbf3)' : 'var(--status-danger-light, #fde9e9)';
        toastEl.style.color = isSuccess ? 'var(--status-success, #028066)' : 'var(--status-danger, #b42318)';
        toastEl.style.borderRadius = 'var(--radius-lg, 14px)';
        toastEl.style.boxShadow = 'var(--shadow-lg, 0 12px 28px rgba(14,59,54,0.14))';

        var ikona = isSuccess
            ? '<i class="bi bi-check-circle-fill me-2 fs-5"></i>'
            : '<i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>';

        toastEl.innerHTML = '<div class="d-flex align-items-center p-3">' +
            ikona +
            '<div class="toast-body flex-grow-1 fw-semibold" style="font-size: var(--text-small, 0.9rem); color: inherit; padding: 0;">' + poruka + '</div>' +
            '<button type="button" class="btn-close ms-2 me-1" data-bs-dismiss="toast" aria-label="Zatvori"></button>' +
            '</div>';

        container.appendChild(toastEl);

        if (typeof bootstrap !== 'undefined' && bootstrap.Toast) {
            var toast = new bootstrap.Toast(toastEl, { delay: 3500, autohide: true });
            toast.show();
            toastEl.addEventListener('hidden.bs.toast', function () { if (toastEl.parentNode) toastEl.parentNode.removeChild(toastEl); });
        } else {
            setTimeout(function () { if (toastEl.parentNode) toastEl.parentNode.removeChild(toastEl); }, 3500);
        }
    }

    document.addEventListener('click', async function (e) {
        var btn = e.target.closest('.prijavi-se-btn');
        if (!btn) return;
        e.stopPropagation();
        e.preventDefault();

        var oglasId = btn.getAttribute('data-oglas-id');
        if (!oglasId) return;

        btn.disabled = true;
        var originalHTML = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Prijava...';

        try {
            var body = new URLSearchParams();
            body.append('oglasId', oglasId);

            var resp = await fetch('/Oglas/PrijaviRadnikaNaOglas', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': csrfToken
                },
                body: body.toString(),
                credentials: 'same-origin'
            });

            if (!resp.ok) {
                var msgErr = 'Prijava nije uspjela. Pokušajte ponovo.';
                try {
                    var jErr = await resp.json();
                    if (jErr && jErr.message) msgErr = jErr.message;
                } catch (_) { }
                showNaposoToast(msgErr, 'danger');
                btn.disabled = false;
                btn.innerHTML = originalHTML;
                return;
            }

            var data = { success: true, message: 'Uspješno ste se prijavili na oglas.' };
            try {
                var jData = await resp.json();
                if (jData && typeof jData.success !== 'undefined') {
                    if (typeof jData.message !== 'undefined') data.message = jData.message;
                    data.success = jData.success;
                }
            } catch (_) { }

            if (data.success) {
                showNaposoToast(data.message, 'success');
                var replacement = document.createElement('div');
                replacement.className = 'text-success fw-semibold';
                replacement.style.fontSize = 'var(--text-caption)';
                replacement.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Prijavljeni ste';
                if (btn.parentNode) btn.parentNode.replaceChild(replacement, btn);
            } else {
                showNaposoToast(data.message || 'Prijava nije uspjela.', 'danger');
                btn.disabled = false;
                btn.innerHTML = originalHTML;
            }
        } catch (err) {
            showNaposoToast('Došlo je do greške prilikom prijave.', 'danger');
            btn.disabled = false;
            btn.innerHTML = originalHTML;
        }
    });
})();
</script>
}
