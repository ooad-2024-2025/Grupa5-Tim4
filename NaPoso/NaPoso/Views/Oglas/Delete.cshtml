@model NaPoso.Models.Oglas

@{
    ViewData["Title"] = "Obriši oglas";
}

<div class="page-header page-header-danger text-center">
    <h1><i class="bi bi-trash me-2"></i>Obriši oglas</h1>
</div>

<!-- CENTRIRANI SADRŽAJ (mx-auto + justify-content-center) -->
<div class="row justify-content-center">
    <div class="col-lg-7 mx-auto">
        <div class="alert alert-danger text-center">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Da li ste sigurni da želite obrisati ovaj oglas? Ova radnja se ne može poništiti.
        </div>

        <div class="content-card">
            <dl class="row mb-0 align-items-center">
                <dt class="col-sm-4 text-sm-end">Naslov</dt>
                <dd class="col-sm-8"><strong>@Model.Naslov</strong></dd>

                <dt class="col-sm-4 text-sm-end">Opis</dt>
                <dd class="col-sm-8">@Model.Opis</dd>

                <dt class="col-sm-4 text-sm-end">Lokacija</dt>
                <dd class="col-sm-8">@LokacijaHelper.UGradu(Model.Lokacija)</dd>

                <dt class="col-sm-4 text-sm-end">Tip posla</dt>
                <dd class="col-sm-8">@Model.TipPosla</dd>

                <dt class="col-sm-4 text-sm-end">Cijena</dt>
                <dd class="col-sm-8"><strong class="text-accent">@Model.CijenaPosla KM</strong></dd>

                <dt class="col-sm-4 text-sm-end">Status</dt>
                <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Status</span></dd>
            </dl>
        </div>

        <!-- Centrirani form dugmići -->
        <form asp-action="Delete" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-3 justify-content-center">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Obriši</button>
                @if (User.IsInRole("Klijent"))
                {
                    <a asp-action="OglasiKlijenta" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
                }
            </div>
        </form>
    </div>
</div>
