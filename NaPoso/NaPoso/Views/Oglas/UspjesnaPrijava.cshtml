@{
    ViewData["Title"] = "Uspješna prijava";
}

<div class="auth-container">
    <div class="auth-card text-center">
        <h1 class="auth-icon" style="color: var(--color-success);"><i class="bi bi-check-circle-fill"></i></h1>
        <h1 style="color: var(--color-success);">Uspješna prijava</h1>
        <p class="lead">Vaša prijava je uspješno primljena.</p>
        <p class="form-hint" style="text-align: center;">Čekamo potvrdu klijenta i uplatu sredstava.</p>

        <div class="mt-4">
            <a asp-controller="Oglas" asp-action="PrikazOglasa" class="btn btn-primary">
                <i class="bi bi-arrow-left me-1"></i>Nazad na ponude poslova
            </a>
        </div>
    </div>
</div>
