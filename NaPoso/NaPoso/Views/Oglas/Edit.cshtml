@model NaPoso.Models.Oglas

@{
    ViewData["Title"] = "Uredi oglas";
}

<div class="page-header">
    <h1><i class="bi bi-pencil me-2"></i>Uredi oglas</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="content-card">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" asp-for="Id" />

                <div class="form-group">
                    <label asp-for="Naslov" class="form-label"></label>
                    <input asp-for="Naslov" class="form-control" />
                    <span asp-validation-for="Naslov" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Opis" class="form-label"></label>
                    <input asp-for="Opis" class="form-control" />
                    <span asp-validation-for="Opis" class="text-danger"></span>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Lokacija" class="form-label"></label>
                            <input asp-for="Lokacija" class="form-control" />
                            <span asp-validation-for="Lokacija" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="TipPosla" class="form-label"></label>
                            <input asp-for="TipPosla" class="form-control" />
                            <span asp-validation-for="TipPosla" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label asp-for="CijenaPosla" class="form-label"></label>
                    <input asp-for="CijenaPosla" class="form-control" />
                    <span asp-validation-for="CijenaPosla" class="text-danger"></span>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Spremi</button>
                    @if (User.IsInRole("Klijent"))
                    {
                        <a asp-action="OglasiKlijenta" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
