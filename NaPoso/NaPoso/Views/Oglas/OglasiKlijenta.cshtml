@using NaPoso.Helpers
@using static NaPoso.Enums.Enums
@model IEnumerable<Oglas>

@{
    ViewData["Title"] = "Moji oglasi";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-megaphone me-2"></i>Moji oglasi</h1>
        <p class="lead">Upravljajte svojim oglasima</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Objavi oglas</a>
</div>

<div class="mb-4 animate-fade-in-up">
    <form method="get" class="d-flex gap-2 flex-wrap">
        <input type="text" name="query" class="form-control" style="max-width: 250px;" placeholder="Pretraga po naslovu..." value="@ViewBag.CurrentQuery" />
        <select name="filter" class="form-select" style="max-width: 160px;">
            <option value="Svi" selected="@(ViewBag.CurrentFilter == "Svi")">Svi (@ViewBag.UkupnoSvih)</option>
            <option value="Aktivni" selected="@(ViewBag.CurrentFilter == "Aktivni")">Aktivni (@ViewBag.UkupnoAktivnih)</option>
            <option value="Zavrseni" selected="@(ViewBag.CurrentFilter == "Zavrseni")">Završeni (@ViewBag.UkupnoZavrsenih)</option>
        </select>
        <button type="submit" class="btn btn-secondary"><i class="bi bi-funnel"></i> Filtriraj</button>
    </form>
</div>

@if (!Model.Any())
{
    var filter = ViewBag.CurrentFilter as string;
    <div class="empty-state rounded-4 p-5" style="border: 2px dashed var(--color-border); background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-2) 100%);">
        <div class="empty-state-icon" style="font-size: 4rem; color: var(--color-accent); opacity: 0.6;"><i class="bi bi-inbox"></i></div>
        @if (filter == "Aktivni")
        {
            <h3 class="mt-3" style="font-weight: 700;">Nemate aktivnih oglasa</h3>
            <p class="lead mt-1 mb-4" style="max-width: 520px; margin: 0 auto;">
                Trenutno nemate niti jedan aktivan oglas koji traži radnike. Kada objavite novi oglas, automatski će se pojaviti ovdje.
            </p>
            <a asp-action="Create" class="btn btn-primary btn-lg mt-2"><i class="bi bi-plus-lg me-1"></i>Objavi prvi oglas</a>
        }
        else if (filter == "Zavrseni")
        {
            <h3 class="mt-3" style="font-weight: 700;">Još uvijek nemate završenih oglasa</h3>
            <p class="lead mt-1 mb-4" style="max-width: 520px; margin: 0 auto;">
                Kada klijent potvrdi isplatu i posao se obilježi kao završen, biće prikazan u ovoj sekciji kao dio vaše povijesti poslova.
            </p>
            <a asp-action="Create" class="btn btn-ghost btn-lg mt-2"><i class="bi bi-lightbulb me-1"></i>Saznajte više o procesu</a>
        }
        else
        {
            <h3 class="mt-3" style="font-weight: 700;">Još uvijek nemate nijedan oglas</h3>
            <p class="lead mt-1 mb-4" style="max-width: 520px; margin: 0 auto;">
                Nemate niti aktivnih niti završenih oglasa. Krenite od objavljivanja svog prvog oglasa i pronađite odgovarajućeg radnika za vaš posao.
            </p>
            <a asp-action="Create" class="btn btn-primary btn-lg mt-2"><i class="bi bi-plus-lg me-1"></i>Krenite sada — objavite oglas</a>
        }
    </div>
}
else
{
    <div class="row g-4 animate-fade-in-up">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="content-card h-100 d-flex flex-column" style="cursor: pointer;" onclick="window.location='@Url.Action("PrijavljeniRadnici", new { oglasId = item.Id })'">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h4 class="mb-0 text-truncate" style="font-family: var(--font-heading); max-width: 70%;" title="@item.Naslov">@item.Naslov</h4>
                        @{
                            var statusLabel = OglasStatusHelper.GetLabel(item.Status);
                            var statusBadgeClass = statusLabel == "Završen" ? "bg-secondary" : "bg-success";
                        }
                        <span class="badge @statusBadgeClass px-2 py-1">
                            @statusLabel
                        </span>
                    </div>
                    
                    <div class="text-muted mb-4" style="font-size: var(--text-small);">
                        <i class="bi bi-geo-alt me-1"></i>@LokacijaHelper.UGradu(item.Lokacija)
                    </div>
                    
                    <div class="mt-auto pt-3 border-top d-flex gap-2 justify-content-between align-items-center">
                        <a asp-action="PrijavljeniRadnici" asp-route-oglasId="@item.Id" class="btn btn-primary btn-sm flex-grow-1" onclick="event.stopPropagation()">
                            <i class="bi bi-people me-1"></i>Radnici
                        </a>
                        @if (item.Status != Status.Zavrsen)
                        {
                            <form asp-action="Zavrsi" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="event.stopPropagation()">
                                <button type="submit" class="btn btn-ghost btn-sm px-2 text-success" title="Završi oglas">
                                    <i class="bi bi-check2-circle"></i>
                                </button>
                            </form>
                        }
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-ghost btn-sm px-2" title="Uredi" onclick="event.stopPropagation()">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-ghost btn-sm px-2 text-danger" title="Obriši" onclick="event.stopPropagation()">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
</div>
