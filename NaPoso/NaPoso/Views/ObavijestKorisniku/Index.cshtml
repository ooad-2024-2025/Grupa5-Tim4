@model IEnumerable<NaPoso.Models.ObavijestKorisniku>

@{
    ViewData["Title"] = "Obavijesti korisnicima";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-bell me-2"></i>Obavijesti korisnicima</h1>
        <p class="lead">Upravljajte obavijestima</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nova obavijest</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-bell"></i></div>
        <h3>Nema obavijesti</h3>
        <p>Kreirajte prvu obavijest za korisnike.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Korisnik ID</th>
                    <th>Akcije</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><code style="font-size: var(--text-caption);">@item.KorisnikId</code></td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-ghost btn-sm"><i class="bi bi-pencil me-1"></i>Uredi</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-ghost btn-sm"><i class="bi bi-eye me-1"></i>Detalji</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-ghost btn-sm text-danger"><i class="bi bi-trash me-1"></i>Obriši</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
