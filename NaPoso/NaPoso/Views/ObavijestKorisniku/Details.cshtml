@model NaPoso.Models.ObavijestKorisniku

@{
    ViewData["Title"] = "Detalji obavijesti";
}

<div class="page-header">
    <h1><i class="bi bi-info-circle me-2"></i>Detalji obavijesti</h1>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="content-card">
            <dl class="row mb-0">
                <dt class="col-sm-3">Korisnik</dt>
                <dd class="col-sm-9"><code style="font-size: var(--text-caption);">@Model.KorisnikId</code></dd>
            </dl>
        </div>

        <div class="d-flex gap-3 mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Uredi</a>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Nazad</a>
        </div>
    </div>
</div>
